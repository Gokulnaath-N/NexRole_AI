# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL via Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Firebase Admin SDK credentials
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Redis (Upstash / Local)
REDIS_URL="redis://localhost:6379"

# AI Microservices URLs
RAG_SERVICE_URL="http://localhost:8001"
NLP_SERVICE_URL="http://localhost:8002"
GENAI_SERVICE_URL="http://localhost:8003"
RECOMMENDATION_SERVICE_URL="http://localhost:8004"
AGENT_SERVICE_URL="http://localhost:8005"

# Third-party AI API Keys (Used directly by backend for fallbacks/simulators)
GEMINI_API_KEY="your-gemini-api-key"

# MCP Server Configuration
MCP_BRAVE_SEARCH_URL="https://your-brave-mcp-server/sse"
MCP_GITHUB_URL="https://your-github-mcp-server/sse"
GITHUB_TOKEN="ghp_your_github_personal_access_token"
MCP_FILESYSTEM_PATH="./uploads"
# Note: postgresql MCP server uses existing DATABASE_URL
